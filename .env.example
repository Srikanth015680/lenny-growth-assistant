# ---------------------------------------------------------------------------
# The Lenny Growth Assistant — environment configuration
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------
# Async SQLAlchemy URL (asyncpg driver). In Docker Compose this points at the
# `db` service; for local (non-Docker) dev point it at localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lenny_growth_assistant

# --- LLM providers --------------------------------------------------------
# "ollama" or "anthropic". Ollama is the default — the app must work with
# this alone and no Anthropic key.
DEFAULT_LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# Seconds to wait for Ollama before returning a structured timeout error.
OLLAMA_TIMEOUT_SECONDS=60

# Optional. If unset, Anthropic is simply unavailable and the app falls
# back to / stays on Ollama. Never hard-code this value.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Embeddings / retrieval ------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=5
# Cosine similarity threshold below which we return a grounded refusal
# instead of a synthesized answer.
RETRIEVAL_THRESHOLD=0.35

# --- App --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000
MAX_MESSAGE_LENGTH=4000

# --- Transcript source ------------------------------------------------
# Where backend/scripts/download_transcripts.py pulls source data from.
# Not committed in this repo — see docs/troubleshooting.md.
TRANSCRIPT_SOURCE_URL=

# --- Frontend -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
